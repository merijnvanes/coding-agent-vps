[Unit]
Description=SSH agent for the creds user (signing oracle for sandbox git ops)
Documentation=https://github.com/merijnvanes/coding-agent-vps

[Service]
Type=forking
User=creds
Group=creds
# Sockets dir is 0755 so the rootless-Docker-mapped sandbox UID can traverse
# it. Actual access to the socket file is gated by the socket's own mode
# (0660) + the agent-sockets group, which the sandbox container is added to
# via subgid mapping configured at cloud-init time.
ExecStartPre=/usr/bin/install -d -m 0755 -o creds -g creds /var/lib/agent-vps/sockets
# -a sets the socket path; ssh-agent creates the file as 0600 owned by creds:creds.
ExecStart=/usr/bin/ssh-agent -a /var/lib/agent-vps/sockets/ssh-agent.sock
# Hand the socket over to the agent-sockets group with 0660 so the sandbox
# (via subgid-mapped membership) can connect() but cannot unlink().
ExecStartPost=/bin/chgrp agent-sockets /var/lib/agent-vps/sockets/ssh-agent.sock
ExecStartPost=/bin/chmod 0660 /var/lib/agent-vps/sockets/ssh-agent.sock
KillMode=mixed
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/agent-vps
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
