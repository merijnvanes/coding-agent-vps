[Unit]
Description=SSH agent for the creds user (signing oracle for sandbox git ops)
Documentation=https://github.com/merijnvanes/coding-agent-vps

[Service]
Type=forking
User=creds
Group=creds
# Sockets dir is 0755 so the rootless-Docker-mapped sandbox UID can traverse
# it. Actual access to the socket file is gated by the socket's own mode
# (0666); the agent-sockets group approach was dropped because rootless
# via subgid mapping configured at cloud-init time.
# PRECONDITION (set up at cloud-init time):
#   - directories: /var/lib/agent-vps/{,sockets} exist
# Socket mode 0666 — every local process that can traverse the sockets dir
# can connect(). On this host the local process set is {root, creds, dev,
# rootless-Docker-mapped UIDs from dev's subuid range}, all of which are
# trusted by the design. Group-gated 0660 would require a custom user-
# namespace mapping that rootless Docker doesn't cleanly expose; the practical
# access set is identical. Documented as accepted residual.
ExecStartPre=/usr/bin/install -d -m 0755 /var/lib/agent-vps/sockets
# Remove any stale socket file from a previous instance that didn't shut
# down cleanly (e.g. host hard-reset, a failed re-run of cloud-init-tasks.sh).
# ssh-agent's bind() would otherwise fail with EADDRINUSE and leave this
# unit in `failed` state — sandbox git push then breaks with "Permission
# denied (publickey)". Safe because each ExecStart creates a fresh socket.
ExecStartPre=/usr/bin/rm -f /var/lib/agent-vps/sockets/ssh-agent.sock
# -P "": an empty allow-list for PKCS#11 and FIDO middleware libraries.
# The sandbox talks the full agent protocol through the bridge, and
# ssh-agent treats it as a local client, so without this it would
# dlopen() any library under /usr/lib*/* on request (`ssh-add -s`) as
# creds. We only ever load a plain key file, so refuse every provider.
ExecStart=/usr/bin/ssh-agent -P "" -a /var/lib/agent-vps/sockets/ssh-agent.sock
ExecStartPost=/bin/chmod 0666 /var/lib/agent-vps/sockets/ssh-agent.sock
# Load the cached GitHub key on every start (boot, restart, recovery
# after an OOM kill), so a fresh agent is never left empty until the next
# cred-daemon run. "-": the file does not exist before bootstrap.sh;
# cred-daemon still owns fetching and swapping the key.
ExecStartPost=-/usr/bin/env SSH_AUTH_SOCK=/var/lib/agent-vps/sockets/ssh-agent.sock /usr/bin/ssh-add -q /var/lib/agent-vps/creds/github-ssh-key
KillMode=mixed
Restart=on-failure
RestartSec=2
# The sandbox can add keys of its own through the bridge, and ssh-agent
# has no cap on how many it holds. Bound what that can cost the host,
# swap included (this unit sits outside sandbox.slice). One key needs a
# few MB; ssh-agent is a single process. If the cap is hit, the OOM kill
# restarts the agent with the cached key.
TasksMax=16
MemoryMax=64M
MemorySwapMax=0
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/agent-vps
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
