#!/usr/bin/env bash
# sandbox/wrappers/hcloud — PATH shim
#
# Fetches HCLOUD_TOKEN from the coding-agent-vps-tooling Infisical project
# at command-invocation time and passes only that one secret to the real
# hcloud, for one command. No persistent on-disk copy in the sandbox. The
# other tooling secrets stay out of this process, so code that hcloud runs
# never sees the Cloudflare or Supabase tokens.
#
# Real binary: /usr/local/bin/hcloud
# Shim is on PATH ahead of /usr/local/bin via the Dockerfile's PATH=.../opt/agent-vps-wrappers:...
#
# Requires:
#   - INFISICAL_TOOLING_PROJECT_ID (from /run/agent-env/sandbox-config.sh, sourced by /etc/profile.d/agent-env.sh)
#   - INFISICAL_ENV (defaults to dev if unset)
#   - The host's agent token (sandbox/wrappers/infisical reads it)

set -euo pipefail

: "${INFISICAL_TOOLING_PROJECT_ID:?INFISICAL_TOOLING_PROJECT_ID not set — host bootstrap.sh has not populated /run/agent-env/sandbox-config.sh, or this shell did not source /etc/profile.d/agent-env.sh}"
: "${INFISICAL_ENV:=dev}"

# Exports one tooling secret as $2 (default: its own name). A missing
# secret stays unset, as it did under `infisical run`.
export_secret() {
  local value
  value=$(infisical secrets get --projectId="$INFISICAL_TOOLING_PROJECT_ID" --env="$INFISICAL_ENV" --plain "$1")
  [[ -z "$value" ]] || export "${2:-$1}=$value"
}

export_secret HCLOUD_TOKEN
exec /usr/local/bin/hcloud "$@"
