#!/usr/bin/env bash
# sandbox/wrappers/wrangler — PATH shim
#
# Fetches CLOUDFLARE_API_TOKEN from the coding-agent-vps-tooling Infisical
# project at command-invocation time and passes only that one secret to
# the real wrangler. wrangler runs the project's build, so third-party
# code sees this process's environment. See sandbox/wrappers/hcloud for
# the full pattern + env var requirements.
#
# Real binary: /usr/local/pnpm/bin/wrangler

set -euo pipefail

: "${INFISICAL_TOOLING_PROJECT_ID:?INFISICAL_TOOLING_PROJECT_ID not set — host bootstrap.sh has not populated /run/agent-env/sandbox-config.sh, or this shell did not source /etc/profile.d/agent-env.sh}"
: "${INFISICAL_ENV:=dev}"

# Exports one tooling secret as $2 (default: its own name). A missing
# secret stays unset, as it did under `infisical run`.
export_secret() {
  local value
  value=$(infisical secrets get --projectId="$INFISICAL_TOOLING_PROJECT_ID" --env="$INFISICAL_ENV" --plain "$1")
  [[ -z "$value" ]] || export "${2:-$1}=$value"
}

export_secret CLOUDFLARE_API_TOKEN
exec /usr/local/pnpm/bin/wrangler "$@"
